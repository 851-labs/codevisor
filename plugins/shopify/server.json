{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.codevisor/shopify",
  "title": "Shopify",
  "description": "Manage your Shopify store: products, inventory, discounts, orders, customers and analytics, through the Shopify CLI.",
  "version": "1.0.0",
  "websiteUrl": "https://shopify.dev/docs/apps/build/ai-toolkit",
  "icons": [
    {
      "src": "https://setup.shopify.com/icons/shopify.png"
    }
  ],
  "repository": {
    "url": "https://github.com/851-labs/codevisor",
    "source": "github",
    "subfolder": "plugins/shopify"
  },
  "_meta": {
    "dev.codevisor/plugin": {
      "bundled": "shopify",
      "entry": "dist/main.js",
      "ageRating": 4,
      "featureFlag": "shopifyPlugin",
      "accounts": {
        "label": "Shopify store",
        "oauth": {
          "provider": "shopify",
          "client": "plugin",
          "scopes": [
            "read_products",
            "write_products",
            "read_inventory",
            "write_inventory",
            "read_locations",
            "read_orders",
            "read_customers",
            "read_discounts",
            "write_discounts",
            "read_reports",
            "read_themes",
            "read_content"
          ]
        },
        "fields": [
          {
            "key": "store",
            "label": "Store address",
            "type": "string",
            "required": true,
            "placeholder": "my-store.myshopify.com",
            "help": "Your store's myshopify.com address, from Shopify admin › Settings › Domains."
          }
        ]
      },
      "capabilities": {
        "tools": [
          {
            "name": "run_query",
            "description": "Look up store data with Admin GraphQL",
            "effects": "read"
          },
          {
            "name": "run_analytics",
            "description": "Run ShopifyQL reports",
            "effects": "read"
          },
          {
            "name": "run_mutation",
            "description": "Change the store after approval",
            "effects": "external-write"
          }
        ],
        "events": [],
        "skills": [
          {
            "name": "shopify",
            "description": "Manage the user's Shopify store safely: look things up with Admin GraphQL and ShopifyQL, and change the store only after explicit approval."
          }
        ],
        "panes": [],
        "ingress": []
      }
    }
  }
}
