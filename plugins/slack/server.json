{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.codevisor/slack",
  "title": "Slack",
  "description": "Search, read and post in Slack as you, and wake bots on mentions, DMs and replies.",
  "version": "1.0.0",
  "websiteUrl": "https://codevisor.dev/docs/plugins/slack",
  "icons": [
    {
      "src": "https://a.slack-edge.com/80588/marketing/img/icons/icon_slack_hash_colored.png"
    }
  ],
  "repository": {
    "url": "https://github.com/851-labs/codevisor",
    "source": "github",
    "subfolder": "plugins/slack"
  },
  "_meta": {
    "dev.codevisor/plugin": {
      "bundled": "slack",
      "entry": "dist/main.js",
      "ageRating": 4,
      "featureFlag": "slackPlugin",
      "accounts": {
        "label": "Slack workspace",
        "noun": "workspace",
        "fields": [
          {
            "key": "signingSecret",
            "label": "Signing Secret",
            "type": "secret",
            "required": true,
            "placeholder": "Paste signing secret…"
          },
          {
            "key": "userToken",
            "label": "User OAuth Token",
            "type": "secret",
            "required": true,
            "placeholder": "Paste user OAuth token…"
          }
        ],
        "guide": {
          "title": "Connect Slack",
          "summary": "Connect Slack through a small app in your workspace. It takes about two minutes.",
          "steps": [
            {
              "title": "Create the Slack app",
              "detail": "Create a Slack app to give your agents access to Slack.",
              "link": {
                "title": "Create Slack App",
                "url": "https://api.slack.com/apps?new_app=1",
                "query": {
                  "manifest_json": {
                    "display_information": {
                      "name": "Codevisor",
                      "description": "Lets your Codevisor agents read Slack and post as you, with your approval.",
                      "background_color": "#1c1c1e"
                    },
                    "oauth_config": {
                      "scopes": {
                        "user": [
                          "channels:history",
                          "channels:read",
                          "chat:write",
                          "files:read",
                          "files:write",
                          "groups:history",
                          "groups:read",
                          "im:history",
                          "im:read",
                          "im:write",
                          "mpim:history",
                          "mpim:read",
                          "reactions:read",
                          "reactions:write",
                          "search:read",
                          "users:read",
                          "users:read.email"
                        ]
                      }
                    },
                    "settings": {
                      "event_subscriptions": {
                        "request_url": "{{ingress.slack}}",
                        "user_events": [
                          "message.channels",
                          "message.groups",
                          "message.im",
                          "message.mpim",
                          "reaction_added"
                        ]
                      },
                      "org_deploy_enabled": false,
                      "socket_mode_enabled": false,
                      "token_rotation_enabled": false
                    }
                  }
                }
              }
            },
            {
              "title": "Signing Secret",
              "detail": "Copy the Signing Secret from Basic Information › App Credentials.",
              "fields": ["signingSecret"]
            },
            {
              "title": "User OAuth Token",
              "detail": "Copy the User OAuth Token from OAuth & Permissions › OAuth Tokens.",
              "fields": ["userToken"]
            }
          ]
        }
      },
      "capabilities": {
        "tools": [
          {
            "name": "search_messages",
            "description": "Search messages",
            "effects": "read"
          },
          {
            "name": "search_files",
            "description": "Search shared files",
            "effects": "read"
          },
          {
            "name": "list_channels",
            "description": "List your conversations",
            "effects": "read"
          },
          {
            "name": "find_users",
            "description": "Find people",
            "effects": "read"
          },
          {
            "name": "get_user",
            "description": "Get a person's profile",
            "effects": "read"
          },
          {
            "name": "read_channel",
            "description": "Read a conversation",
            "effects": "read"
          },
          {
            "name": "read_thread",
            "description": "Read a thread",
            "effects": "read"
          },
          {
            "name": "list_channel_members",
            "description": "List a conversation's members",
            "effects": "read"
          },
          {
            "name": "download_file",
            "description": "Download a shared file",
            "effects": "read"
          },
          {
            "name": "add_reaction",
            "description": "Add a reaction",
            "effects": "write"
          },
          {
            "name": "remove_reaction",
            "description": "Remove a reaction",
            "effects": "write"
          },
          {
            "name": "post_message",
            "description": "Post a message after approval",
            "effects": "external-write"
          },
          {
            "name": "schedule_message",
            "description": "Schedule a message after approval",
            "effects": "external-write"
          },
          {
            "name": "upload_file",
            "description": "Share a file after approval",
            "effects": "external-write"
          }
        ],
        "events": [
          {
            "name": "message.posted",
            "description": "Someone posted in a conversation you're in"
          },
          {
            "name": "mention.created",
            "description": "Someone @-mentioned you"
          },
          {
            "name": "dm.received",
            "description": "Someone sent you a direct message"
          },
          {
            "name": "thread.replied",
            "description": "Someone replied in a thread you started"
          },
          {
            "name": "reaction.added",
            "description": "Someone reacted to your message"
          }
        ],
        "skills": [
          {
            "name": "slack",
            "description": "Work in the user's Slack safely: search and read conversations, post only with explicit approval, and react to Slack events with filters."
          }
        ],
        "panes": [],
        "ingress": [
          {
            "name": "slack",
            "title": "Slack events URL"
          }
        ]
      }
    }
  }
}
