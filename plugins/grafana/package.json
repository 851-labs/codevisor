{
  "name": "@codevisor/plugin-grafana",
  "private": true,
  "type": "module",
  "exports": {
    "./server.json": "./server.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile tmp/typecheck.tsbuildinfo --pretty false",
    "test": "vitest run src --passWithNoTests",
    "test:coverage": "vitest run src --coverage"
  },
  "dependencies": {
    "@codevisor/plugin-kit": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "vitest": "4.1.6"
  }
}
