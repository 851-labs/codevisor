{
  "format-lint": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "../scripts/agent-hooks/agy-report.sh",
        "timeout": 60
      }
    ]
  },
  "kill-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "../scripts/agent-hooks/kill-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
