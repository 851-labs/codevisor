{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codevisor-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "cloud.codevisor.dev", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "bun run build:css",
    "watch_dir": "src/pages"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [{ "name": "USER_HUB", "class_name": "UserHub" }]
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "kv_namespaces": [
    {
      "binding": "PLUGIN_INDEX",
      "id": "85743d49d3a241f99548cd6ad3179f3e"
    }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserHub"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codevisor-cloud",
      "database_id": "3daedd29-b7cb-4b07-bc92-a49c239cc4bc",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "APPLE_NATIVE_CLIENT_ID": "com.dylanplayer.codevisor.ios",
    "PUBLIC_BASE_URL": "https://cloud.codevisor.dev",
    "INSTANCE_NAME": "Codevisor Cloud"
  }
}
