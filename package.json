{
  "name": "codevisor",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "dev:macos": "bun scripts/dev.mjs --no-ios",
    "dev:ios": "bun scripts/dev-ios.mjs",
    "build:macos": "bun scripts/build-native.mjs macos",
    "build:ios": "bun scripts/build-native.mjs ios",
    "screenshots:macos": "bun scripts/screenshots-macos.mjs",
    "screenshots:ios": "bun scripts/screenshots-ios.mjs",
    "build:pixelbook": "bun scripts/build-native.mjs pixelbook",
    "ghostty:build": "bun scripts/ghostty-artifact.mjs build",
    "dev:scripts:test": "node --test scripts/*.test.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint -c .oxlintrc.json --disable-nested-config --report-unused-disable-directives-severity=error .",
    "format": "oxfmt -c .oxfmtrc.json --disable-nested-config --write .",
    "format:check": "oxfmt -c .oxfmtrc.json --disable-nested-config --check .",
    "test": "turbo run test --concurrency=4",
    "test:coverage": "turbo run test:coverage --concurrency=4",
    "check:js": "bun run format:check && bun run lint && bun run ratchet:check && bun run boundaries && bun run typecheck && bun run test:coverage && bun run dev:scripts:test && bun run release:scripts:test",
    "check": "bun run check:js && bun run swift:format:check && bun run swift:lint && bun run swift:test && bun run swift:test:macos-transcript && bun run swift:build:ios",
    "dev:web": "bun run --cwd apps/www dev",
    "release:server": "scripts/release/build-server-archive.sh",
    "release:browser-extension": "node scripts/release/build-browser-extension.mjs",
    "release:browser-extension:publish": "node scripts/release/publish-browser-extension.mjs",
    "release:browser-extension:test": "node --test scripts/release/publish-browser-extension.test.mjs",
    "release:scripts:test": "node --test scripts/release/*.test.mjs",
    "release:macos": "scripts/release/build-macos-app.sh",
    "release:tap": "node scripts/release/update-homebrew-tap.mjs",
    "setup:github-oauth": "node scripts/setup-github-oauth.mjs",
    "screen-sharing:probe": "bun apps/screen-sharing-rig/scripts/screen-sharing-probe.ts",
    "screen-sharing:rig": "bun apps/screen-sharing-rig/scripts/screen-sharing-rig.ts",
    "vnc:bench": "bun apps/screen-sharing-rig/scripts/vnc-bench.mjs",
    "vnc:interop": "bun apps/screen-sharing-rig/scripts/vnc-interop.mjs",
    "vnc:tophat": "bun apps/screen-sharing-rig/scripts/vnc-tophat.mjs",
    "vnc:validate": "bun apps/screen-sharing-rig/scripts/vnc-validate.mjs",
    "swift:test": "node scripts/test-swift.mjs",
    "swift:test:macos-transcript": "bun scripts/test-macos-transcript.mjs",
    "swift:build:ios": "bun scripts/build-native.mjs ios -quiet",
    "xcode:list": "bun scripts/build-native.mjs list:macos",
    "swift:lint": "scripts/swift-lint.sh",
    "swift:format": "scripts/swift-format.sh fix",
    "swift:format:check": "scripts/swift-format.sh check",
    "boundaries": "turbo boundaries",
    "ratchet:check": "node scripts/check-size-ratchet.mjs",
    "ios-simulator": "bun scripts/ios-simulator.mjs"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@vitest/coverage-v8": "4.1.6",
    "node-gyp": "13.0.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.42.0",
    "turbo": "2.6.1",
    "typescript": "6.0.2",
    "vitest": "4.1.6"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "ffmpeg-static",
    "node-pty"
  ]
}
