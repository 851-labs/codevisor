{
  "name": "codevisor",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:macos": "bun scripts/dev.ts --no-ios",
    "dev:ios": "bun scripts/dev-ios.ts",
    "build:macos": "bun scripts/build-native.ts macos",
    "build:ios": "bun scripts/build-native.ts ios",
    "screenshots:macos": "bun scripts/screenshots-macos.ts",
    "screenshots:ios": "bun scripts/screenshots-ios.ts",
    "build:pixelbook": "bun scripts/build-native.ts pixelbook",
    "ghostty:build": "bun scripts/ghostty-artifact.ts build",
    "dev:scripts:test": "node --test scripts/*.test.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit --tsBuildInfoFile tmp/typecheck-scripts.tsbuildinfo --pretty false && tsc -p scripts/tsconfig.test.json --noEmit --tsBuildInfoFile tmp/typecheck-scripts-test.tsbuildinfo --pretty false",
    "lint": "oxlint -c .oxlintrc.json --disable-nested-config --report-unused-disable-directives-severity=error .",
    "format": "oxfmt -c .oxfmtrc.json --disable-nested-config --write .",
    "format:check": "oxfmt -c .oxfmtrc.json --disable-nested-config --check .",
    "test": "turbo run test --concurrency=4",
    "test:coverage": "turbo run test:coverage --concurrency=4",
    "check:js": "bun run format:check && bun run lint && bun run ratchet:check && bun run boundaries && bun run typecheck && bun run typecheck:scripts && bun run test:coverage && bun run dev:scripts:test && bun run release:scripts:test",
    "check": "bun run check:js && bun run swift:format:check && bun run swift:lint && bun run swift:test && bun run swift:test:macos-transcript && bun run swift:test:macos-composer && bun run swift:build:ios && bun run swift:test:ios-transcript",
    "dev:web": "bun run --cwd apps/www dev",
    "release:server": "scripts/release/build-server-archive.sh",
    "release:browser-extension": "node scripts/release/build-browser-extension.ts",
    "release:browser-extension:publish": "node scripts/release/publish-browser-extension.ts",
    "release:browser-extension:test": "node --test scripts/release/publish-browser-extension.test.ts",
    "release:scripts:test": "node --test scripts/release/*.test.ts",
    "release:macos": "scripts/release/build-macos-app.sh",
    "release:tap": "node scripts/release/update-homebrew-tap.ts",
    "setup:github-oauth": "node scripts/setup-github-oauth.ts",
    "screen-sharing:probe": "bun scripts/screen-sharing-probe.ts",
    "screen-sharing:rig": "bun scripts/screen-sharing-rig.ts",
    "swift:test": "node scripts/test-swift.ts",
    "swift:test:macos-transcript": "bun scripts/test-macos-transcript.ts",
    "swift:test:macos-composer": "bun scripts/test-macos-composer.ts",
    "swift:test:ios-navigation": "bun scripts/test-ios-navigation.ts",
    "swift:test:ios-transcript": "bun scripts/test-ios-transcript.ts",
    "swift:build:ios": "bun scripts/build-native.ts ios -quiet",
    "xcode:list": "bun scripts/build-native.ts list:macos",
    "swift:lint": "scripts/swift-lint.sh",
    "swift:format": "bun scripts/swift-format.ts fix",
    "swift:format:check": "bun scripts/swift-format.ts check",
    "boundaries": "turbo boundaries",
    "ratchet:check": "node scripts/check-size-ratchet.ts",
    "ios-simulator": "bun scripts/ios-simulator.ts"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@vitest/coverage-v8": "4.1.6",
    "node-gyp": "13.0.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.42.0",
    "turbo": "2.6.1",
    "typescript": "6.0.2",
    "vitest": "4.1.6"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "ffmpeg-static",
    "node-pty"
  ]
}
