{
  "name": "@codevisor/bot-mascot",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@codevisor/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rive/mascot.riv": "./resources/mascot.riv"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile tmp/typecheck.tsbuildinfo --pretty false",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage"
  },
  "dependencies": {
    "clipper-lib": "6.4.2"
  },
  "devDependencies": {
    "@codevisor/vitest-config": "workspace:*",
    "@types/clipper-lib": "6.4.0",
    "vitest": "4.1.6"
  }
}
