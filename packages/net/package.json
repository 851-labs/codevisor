{
  "name": "@codevisor/net",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "build:native": "node ../../scripts/net-artifact.mjs ensure-node",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile tmp/typecheck.tsbuildinfo --pretty false",
    "test": "node ../../scripts/net-artifact.mjs ensure-node && vitest run src --passWithNoTests",
    "test:coverage": "node ../../scripts/net-artifact.mjs ensure-node && vitest run src --coverage"
  },
  "devDependencies": {
    "vitest": "4.1.6"
  }
}
