    "test:coverage": "vitest run src --coverage"
  },
  "dependencies": {
    "e2b": "2.59.0",
    "effect": "4.0.0-beta.92",
    "modal": "0.11.1"
  },
  "devDependencies": {
    "vitest": "4.1.6"
  }
}
