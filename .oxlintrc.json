{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".repos/**",
    "apps/macos/**",
    "packages/swift/**",
    "**/routeTree.gen.ts",
    "**/worker-configuration.d.ts"
  ],
  "plugins": ["typescript", "import", "unicorn", "oxc"],
  "categories": {
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "no-console": "off",
    "typescript/no-explicit-any": "error",
    "max-lines": [
      "error",
      {
        "max": 500
      }
    ],
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "no-unsafe-optional-chaining": "error",
    "preserve-caught-error": "error",
    "no-useless-escape": "error",
    "no-control-regex": "error",
    "no-new": "error",
    "import/no-named-as-default": "error",
    "unicorn/consistent-function-scoping": "error",
    "unicorn/no-array-sort": "error",
    "unicorn/no-array-reverse": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/prefer-add-event-listener": "error",
    "unicorn/require-module-specifiers": "error",
    "no-await-in-loop": "off",
    "oxc/no-map-spread": "off",
    "codevisor/no-comments": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "name": ["test", "describe"],
            "package": "node:test"
          }
        ]
      }
    ],
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_meta", "_splat", "_tag", "_toolName", "__indirect_function_table"]
      }
    ]
  },
  "jsPlugins": ["./scripts/lint/no-comments.mjs"],
  "overrides": [
    {
      "files": [
        "apps/server/src/cli/cloud-control.ts",
        "apps/server/src/infra/active-work-sleep-inhibitor.test.ts",
        "apps/server/src/infra/browser-forward-proxy.test.ts",
        "apps/server/src/infra/credential-coordinator.test.ts",
        "apps/server/src/infra/harness-sync.test.ts",
        "apps/server/src/infra/media-preview-lifecycle.test.ts",
        "apps/server/src/infra/plugin-sync.test.ts",
        "apps/server/src/infra/shared-claude-gateway.test.ts",
        "apps/server/src/infra/shared-provider-runtime.ts",
        "apps/server/src/infra/terminal-persistence.ts",
        "apps/server/src/routes/assistant-artifacts.test.ts",
        "apps/server/src/routes/cloud.ts",
        "apps/server/src/routes/events.test.ts",
        "apps/server/src/routes/execution-annotator.test.ts",
        "apps/server/src/routes/file-delivery.test.ts",
        "apps/server/src/routes/project-repo-identity.ts",
        "apps/server/src/routes/session-browser-cleanup.test.ts",
        "apps/server/src/routes/transcript-storage.test.ts",
        "apps/server/src/routes/workspaces.ts",
        "apps/server/src/server-identity.test.ts",
        "packages/adapter-acp/src/notifications.ts",
        "packages/adapter-acp/src/runtime-account-handoff.test.ts",
        "packages/adapter-acp/src/runtime-acp-inspection-config.test.ts",
        "packages/adapter-acp/src/runtime-acp-sessions.test.ts",
        "packages/adapter-antigravity/src/auth.ts",
        "packages/adapter-cursor/src/extension.test.ts",
        "packages/adapter-cursor/src/extension.ts",
        "packages/adapter-grok-build/src/extension.ts",
        "packages/adapter-muse/src/updates.test.ts",
        "packages/adapter-opencode/src/skill-tool.ts",
        "packages/api/src/openapi.ts",
        "packages/cloud-crypto/src/index.ts",
        "packages/db/src/migrations-projects.test.ts",
        "packages/db/src/transcript-state-pages.ts",
        "packages/harness-manager/src/credential-ferry.ts",
        "packages/harness-manager/src/harness-auth-support.ts",
        "packages/harness-manager/src/harness-catalog-install.test.ts",
        "packages/harness-manager/src/harness-lifecycle-core.ts",
        "packages/harness-manager/src/shared-oauth-providers.test.ts",
        "packages/harness-manager/src/shared-provider-oauth.test.ts",
        "packages/mcp/src/mcp-upstream.ts",
        "packages/mcp/src/native-config-edits.ts",
        "packages/mcp/src/native-config-files.test.ts",
        "packages/mcp/src/native-mcp-import.ts",
        "packages/skills/src/skills-remote-source.ts",
        "packages/terminal/src/vt/ghostty-vt.ts"
      ],
      "rules": {
        "typescript/no-unnecessary-type-assertion": "off"
      }
    },
    {
      "files": [
        "apps/screen-sharing-rig/**",
        "apps/server/src/*.ts",
        "apps/server/src/cli/**",
        "apps/server/src/infra/**",
        "apps/server/src/routes/**",
        "apps/server/test/**",
        "apps/www/**",
        "packages/adapter-acp/**",
        "packages/adapter-antigravity/**",
        "packages/adapter-cursor/**",
        "packages/adapter-grok-build/**",
        "packages/adapter-muse/**",
        "packages/adapter-opencode/**",
        "packages/adapter-pi/**",
        "packages/agent-runtime/**",
        "packages/api/**",
        "packages/cloud-client/**",
        "packages/cloud-crypto/**",
        "packages/db/**",
        "packages/harness-manager/**",
        "packages/mcp/**",
        "packages/net/**",
        "packages/processes/**",
        "packages/skills/**",
        "packages/terminal/**",
        "packages/updater/**",
        "packages/worktrees/**"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
