{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".repos/**",
    "apps/macos/**",
    "packages/swift/**",
    "coverage/**",
    "dist/**",
    "node_modules/**",
    "**/routeTree.gen.ts"
  ],
  "plugins": ["typescript", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-console": "warn",
    "typescript/no-explicit-any": "error",
    "max-lines": [
      "error",
      {
        "max": 500
      }
    ],
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "no-unsafe-optional-chaining": "warn",
    "preserve-caught-error": "warn",
    "no-useless-escape": "warn",
    "no-control-regex": "warn",
    "no-new": "warn",
    "import/no-named-as-default": "warn",
    "unicorn/consistent-function-scoping": "warn",
    "unicorn/no-array-sort": "warn",
    "unicorn/no-array-reverse": "warn",
    "unicorn/no-useless-spread": "warn",
    "unicorn/prefer-add-event-listener": "warn",
    "unicorn/require-module-specifiers": "warn"
  },
  "overrides": [
    {
      "files": [
        "apps/cloud/test/cloud.test.ts",
        "apps/server/src/cli/support.test.ts",
        "apps/server/src/routes/harnesses.ts",
        "apps/server/src/routes/sessions.ts",
        "apps/server/src/serve.ts",
        "apps/server/src/server-context.ts",
        "apps/server/src/server.test.ts",
        "apps/server/src/server.ts",
        "packages/adapter-acp/src/acp.ts",
        "packages/adapter-acp/src/runtime-acp.test.ts",
        "packages/adapter-claude/src/claude.test.ts",
        "packages/adapter-claude/src/claude.ts",
        "packages/adapter-codex/src/provider.test.ts",
        "packages/adapter-codex/src/provider.ts",
        "packages/agent-runtime/src/index.ts",
        "packages/api/src/index.ts",
        "packages/api/src/openapi.ts",
        "packages/automation/src/browser-use-provider.test.ts",
        "packages/automation/src/browser-use-provider.ts",
        "packages/automation/src/code-executor.ts",
        "packages/automation/src/codevisor-provider.ts",
        "packages/automation/src/computer-use-provider.ts",
        "packages/cloud-client/src/machine-connection.test.ts",
        "packages/db/src/index.test.ts",
        "packages/db/src/index.ts",
        "packages/harness-manager/src/harness-auth.ts",
        "packages/harness-manager/src/harness-lifecycle.test.ts",
        "packages/harness-manager/src/harness-lifecycle.ts",
        "packages/harness-manager/src/opencode-auth.ts",
        "packages/mcp/src/mcp-manager.test.ts",
        "packages/mcp/src/mcp-manager.ts",
        "packages/mcp/src/native-config-files.ts",
        "packages/mcp/src/native-mcp-manager.test.ts",
        "packages/mcp/src/native-mcp-manager.ts",
        "packages/skills/src/skills-manager.test.ts",
        "packages/skills/src/skills-manager.ts",
        "packages/terminal/src/index.test.ts",
        "packages/terminal/src/index.ts",
        "packages/worktrees/src/worktree-names.ts",
        "scripts/dev-ios.mjs",
        "scripts/dev.mjs"
      ],
      "rules": {
        "max-lines": "off"
      }
    }
  ]
}
