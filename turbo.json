{
  "$schema": "https://turbo.build/schema.json",
  "cacheDir": "tmp/build/turbo-cache",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "tsconfig.tsbuildinfo"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:chrome": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@codevisor/cloud#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/plugins/*/server.json",
        "$TURBO_ROOT$/plugins/popular.json"
      ],
      "outputs": ["dist/**", "tsconfig.tsbuildinfo"]
    },
    "@codevisor/cloud#test:coverage": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/plugins/*/server.json",
        "$TURBO_ROOT$/plugins/popular.json"
      ],
      "outputs": []
    }
  }
}
