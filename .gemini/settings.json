{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "name": "kill-guard",
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/agent-hooks/kill-guard.mjs",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "name": "format-lint",
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/agent-hooks/post-edit.sh",
            "timeout": 60000
          }
        ]
      }
    ]
  },
  "context": {
    "fileName": ["AGENTS.md", "GEMINI.md"]
  }
}
