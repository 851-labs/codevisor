{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/agent-hooks/post-edit.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
